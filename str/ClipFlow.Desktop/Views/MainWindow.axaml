<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:ClipFlow.Core.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		x:Class="ClipFlow.Desktop.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Title="ClipFlow"
		Width="800" Height="500"
		TransparencyLevelHint="Mica,AcrylicBlur"
		Background="{DynamicResource WindowBackgroundBrush}"
		WindowStartupLocation="CenterScreen">

	<!-- ================== 全局样式 ================== -->
	<Window.Styles>
		<Style Selector="TextBlock">
			<Setter Property="Foreground"
					Value="{DynamicResource TextPrimaryColor}" />
		</Style>
		<!-- 左侧 ListBox 基础 -->
		<Style Selector="ListBox">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<!-- 导航项 -->
		<Style Selector="ListBoxItem">
			<Setter Property="Height" Value="40"/>
			<Setter Property="Margin" Value="6,4"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>



		<!-- 左侧标题 -->
		<Style Selector="TextBlock.NavTitle">
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="20,24,20,16"/>
		</Style>

	</Window.Styles>

	<!-- ================== 主体 ================== -->
	<Grid ColumnDefinitions="150,*">

		<!-- ================== 左侧导航 ================== -->
		<Border Grid.Column="0"
				Background="{DynamicResource SystemAltLowColor}"
				BorderBrush="{DynamicResource SystemBaseLowColor}">

	




				<!-- 导航列表 -->
				<ScrollViewer 
							  VerticalScrollBarVisibility="Auto">
					<ListBox ItemsSource="{Binding NavigationItems}"
							 SelectedItem="{Binding SelectedItem}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="Auto,*"
									  VerticalAlignment="Center">

									<Viewbox Width="16"
											 Height="16"
											 VerticalAlignment="Center">
										<Path Data="{Binding Icon}"
											  Fill="{DynamicResource SystemBaseHighColor}"/>
									</Viewbox>

									<TextBlock Grid.Column="1"
											   Text="{Binding Name}"
											   Margin="12,0,0,0"
											   VerticalAlignment="Center"
											   FontSize="13"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</ScrollViewer>
			
		</Border>

		<!-- ================== 右侧内容区 ================== -->
		<Grid Grid.Column="1"
			  RowDefinitions="Auto,*"
			  Margin="20,10,0,0">

			<!-- 页面标题 -->
			<StackPanel Grid.Row="0"
						Margin="12,0,12,20"
						Spacing="4">

				<TextBlock Text="{Binding SelectedItem.Name}"
						   FontSize="22"
						   FontWeight="SemiBold"/>
			</StackPanel>

			<!-- 内容卡片 -->
			<Grid Grid.Row="1" >
				<Border Padding="12,16,0,0">
					<ContentControl Content="{Binding CurrentPage}"/>
				</Border>
			</Grid>

		</Grid>

	</Grid>
</Window>
