<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ClipFlow.Desktop.ViewModels"
             xmlns:controls="using:ClipFlow.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClipFlow.Desktop.Views.UploadSettingsPage"
             x:DataType="vm:UploadSettingsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,8,0">
        <StackPanel Spacing="20" Margin="30,0,22,0">
			<StackPanel >
				<controls:SettingItem Title="启用上传"
									  BorderThickness="1,1,1,0"
									  CornerRadius="4,4,0,0"
									  Description="允许将剪贴板内容上传到服务器">
					<controls:SettingItem.ActionContent>
						<ToggleSwitch IsChecked="{Binding EnableUpload}"
								OnContent=""
								OffContent=""
								Margin="0,-6,0,-6"/>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>
				<controls:SettingItem Title="启动通知"
					  BorderThickness="1,1,1,0"
					  CornerRadius="0"
					Description="在向服务器上传剪贴板内容的时候通知">
					<controls:SettingItem.ActionContent>
						<ToggleSwitch IsChecked="{Binding EnableUploadNotification}"
									IsEnabled="{Binding EnableUpload}"
									 OnContent=""
									OffContent=""
									Margin="0,-6,0,-6"/>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>
				<controls:SettingItem Title="上传文本"
									  BorderThickness="1,1,1,0"
									  CornerRadius="0"
									 Description="允许上传文本内容">
					<controls:SettingItem.ActionContent>
						<ToggleSwitch IsChecked="{Binding EnableUploadText}"
									IsEnabled="{Binding EnableUpload}"
									OnContent=""
									OffContent=""
									Margin="0,-6,0,-6"/>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>

				<controls:SettingItem Title="上传图片"
									  BorderThickness="1,1,1,0"
									  CornerRadius="0"
									Description="允许上传图片文件">
					<controls:SettingItem.ActionContent>
						<ToggleSwitch IsChecked="{Binding EnableUploadImage}"
									IsEnabled="{Binding EnableUpload}"
									OnContent=""
									OffContent=""
									Margin="0,-6,0,-6"/>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>

				<controls:SettingItem Title="上传文件"
									  BorderThickness="1,1,1,0"
									  CornerRadius="0"
									  
									Description="允许上传单个文件">
					<controls:SettingItem.ActionContent>
						<ToggleSwitch IsChecked="{Binding EnableUploadFile}"
									IsEnabled="{Binding EnableUpload}"
									OnContent=""
									OffContent=""
									Margin="0,-6,0,-6"/>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>

				<controls:SettingItem Title="上传多选文件和文件夹"
									  BorderThickness="1,1,1,0"
									  CornerRadius="0"
									Description="允许上传多个文件或文件夹">
					<controls:SettingItem.ActionContent>
						<ToggleSwitch IsChecked="{Binding EnableUploadMultiple}"
									IsEnabled="{Binding EnableUpload}"
									OnContent=""
									OffContent=""
									Margin="0,-6,0,-6"/>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>
				<controls:SettingItem Title="最大文本长度"
									 BorderThickness="1,1,1,0"
									  CornerRadius="0"
								Description="上传文本的最大字数 (0表示不限制)">
					<controls:SettingItem.ActionContent>
						<NumericUpDown Value="{Binding MaxTextLength}"
									 Minimum="0"
									 Maximum="1000000"
									 Increment="1000"
									 Width="150"/>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>

				<controls:SettingItem Title="最大上传文件大小"
									 BorderThickness="1,1,1,1"
									  CornerRadius="0,0,4,4"
									Description="上传文件的最大大小(MB) (0表示不限制)">
					<controls:SettingItem.ActionContent>
						<NumericUpDown Value="{Binding MaxUploadFileSize}"
									 Minimum="0"
									 Maximum="1000"
									 Increment="10"
									 Width="150"/>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>

			</StackPanel>
			<StackPanel>
				<controls:SettingItem Title="文件后缀过滤"
							 BorderThickness="1,1,1,0"
							 CornerRadius="4,4,0,0"
							 Description="设置允许或禁止的文件后缀">
					<controls:SettingItem.ActionContent>
						<ComboBox SelectedIndex="{Binding IsFileExtensionWhitelist}"
								Width="150">
							<ComboBoxItem>白名单模式</ComboBoxItem>
							<ComboBoxItem>黑名单模式</ComboBoxItem>
						</ComboBox>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>
				<TextBox Text="{Binding FileExtensions}"
						Height="100"
						AcceptsReturn="True"
						TextWrapping="Wrap"
						Watermark="输入文件后缀，以逗号分隔，例如exe,png"
						BorderBrush="#20000000"
						CornerRadius="0,0,4,4"
						BorderThickness="1"/>
			</StackPanel>
			<StackPanel>
				<controls:SettingItem Title="进程名过滤(实验性)"
									 BorderThickness="1,1,1,0"
									 CornerRadius="4,4,0,0"
									 Description="设置允许或禁止的进程名">
					<controls:SettingItem.ActionContent>
						<ComboBox SelectedIndex="{Binding IsProcessNameWhitelist}"
								Width="150">
							<ComboBoxItem>白名单模式</ComboBoxItem>
							<ComboBoxItem>黑名单模式</ComboBoxItem>
						</ComboBox>
					</controls:SettingItem.ActionContent>
				</controls:SettingItem>
				<TextBox Text="{Binding ProcessNames}"
						Height="100"
						AcceptsReturn="True"
						TextWrapping="Wrap"
						Watermark="输入进程名，以逗号分隔，例如：chrome,qq,wechat"
						BorderBrush="#20000000"
						CornerRadius="0,0,4,4"
						BorderThickness="1"/>
				<Grid Margin="10"></Grid>
			</StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl> 